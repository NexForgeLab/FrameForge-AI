<Window x:Class="VideoStudioMvp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="土生视频 · 创作工作台" Icon="Assets/app-logo.png" Width="1440" Height="900" MinWidth="1180" MinHeight="720" Background="{StaticResource AppBg}" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="16,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource SurfaceInput}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Clip="M 0,0 H 36 V 36 H 0 Z"><Image Source="Assets/app-logo.png" Stretch="UniformToFill"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="土生视频" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="AI 视频创作工作台" FontSize="9" Foreground="{StaticResource TextTertiary}" Margin="0,3,0,0"/></StackPanel></StackPanel>
          <TextBlock Text="创作空间" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="4,34,0,10"/>
          <Button x:Name="CreateNavButton" Content="图生视频" Style="{StaticResource GhostButton}" Background="{StaticResource AccentSoft}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,0" Click="CreateWorkspace_Click"/>
          <Button x:Name="ProjectNavButton" Content="项目库" Style="{StaticResource GhostButton}" Margin="0,4,0,0" Click="ProjectLibrary_Click"/><Button x:Name="AssetNavButton" Content="素材管理" Style="{StaticResource GhostButton}" Click="AssetManager_Click"/><Button x:Name="GuideNavButton" Content="使用指南" Style="{StaticResource GhostButton}" Click="Guide_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="2"><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,14"><StackPanel><TextBlock Text="创作模型" FontSize="10" Foreground="{StaticResource TextTertiary}"/><ScrollViewer x:Name="ModeMarqueeViewport" Width="150" Height="21" Margin="0,5,0,2" ClipToBounds="True" Background="Transparent" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Loaded="ModeMarqueeViewport_Loaded" SizeChanged="ModeMarqueeViewport_SizeChanged"><TextBlock x:Name="ModeText" Text="真实生成" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" HorizontalAlignment="Left"/></ScrollViewer><TextBlock x:Name="ModeHint" Text="使用已配置模型" FontSize="10" Foreground="{StaticResource TextSecondary}"/></StackPanel></Border><Button Content="设置" Click="Settings_Click" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Width="176" Height="40" HorizontalContentAlignment="Center"/></StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceRoot" Grid.Column="1" Margin="24,0,24,18"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="图生视频" FontSize="26" FontWeight="SemiBold"/><Border Width="1" Height="24" Background="{StaticResource Line}" Margin="18,0"/><TextBlock Text="从一张图片开始，生成电影级视频" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="12,0" Height="38" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource Success}"/><TextBlock Text="就绪" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="7,0,0,0"/></StackPanel></Border><Button Content="导入项目" Click="ChooseImage_Click" Width="100"/></StackPanel></Grid>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="232"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock Text="创作设置" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="定义画面、动作与节奏" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,5,0,18"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="参考图"/><TextBlock Grid.Column="1" Text="支持 PNG · JPG · WEBP" Foreground="{StaticResource TextTertiary}" FontSize="10" VerticalAlignment="Center"/></Grid>
          <Border x:Name="ImagePreviewBorder" Height="122" Background="{StaticResource SurfaceInput}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="10"><Grid><Image x:Name="ImagePreview" Stretch="Uniform" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel x:Name="ImageEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="上传参考图片" HorizontalAlignment="Center" FontSize="13"/><TextBlock Text="拖放或点击选择" HorizontalAlignment="Center" Foreground="{StaticResource TextTertiary}" FontSize="10" Margin="0,5,0,0"/></StackPanel><Button Content="选择图片" Click="ChooseImage_Click" Width="92" Height="32" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10"/></Grid></Border>
          <TextBox x:Name="ImagePathBox" IsReadOnly="True" Visibility="Collapsed" Height="32" FontSize="10" Padding="10,0" Margin="0,8,0,14" ToolTip="已选择的本地图片路径"/>
          <StackPanel Visibility="Collapsed"><Label Content="参考图 URL（真实 API 模式）"/><TextBox x:Name="ImageUrlBox" ToolTip="公网可访问的图片地址" Margin="0,0,0,14"/></StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="提示词"/><TextBlock Grid.Column="1" Text="描述主体动作与镜头" Foreground="{StaticResource TextTertiary}" FontSize="10" VerticalAlignment="Center"/></Grid>
          <TextBox x:Name="PromptBox" Height="104" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Text="镜头缓慢推进，主体自然运动，光线柔和，电影感，画面稳定" Padding="12,10" VerticalContentAlignment="Top" Margin="0,0,0,14"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><Label Content="画面比例"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="Ratio169Button" GroupName="Ratio" Content="16:9" Tag="16:9" Width="68" Checked="Format_Changed"/><RadioButton x:Name="Ratio916Button" GroupName="Ratio" Content="9:16" Tag="9:16" Width="68" IsChecked="True" Margin="6,0,0,0" Checked="Format_Changed"/><RadioButton x:Name="Ratio11Button" GroupName="Ratio" Content="1:1" Tag="1:1" Width="68" Margin="6,0,0,0" Checked="Format_Changed"/></StackPanel></StackPanel><StackPanel Grid.Column="2"><Label Content="时长（秒）"/><TextBox x:Name="DurationBox" Text="5" ToolTip="请输入 1-15 秒" TextChanged="Duration_Changed"/></StackPanel></Grid>
          <Label Content="输出分辨率" Margin="0,14,0,7"/><StackPanel Orientation="Horizontal"><RadioButton x:Name="Resolution480Button" GroupName="Resolution" Content="480p" Width="78"/><RadioButton x:Name="Resolution720Button" GroupName="Resolution" Content="720p" Width="78" IsChecked="True" Margin="6,0,0,0" Checked="Resolution_Changed"/><RadioButton x:Name="Resolution1080Button" GroupName="Resolution" Content="1080p" Width="78" Margin="6,0,0,0" Checked="Resolution_Changed"/></StackPanel>
          <CheckBox x:Name="AudioBox" Content="同时生成音频" Margin="0,14,0,0"/><Button x:Name="GenerateButton" Content="▶  生成视频" Style="{StaticResource PrimaryButton}" Click="Generate_Click" Margin="0,18,0,0"/><TextBlock Text="Ctrl + Enter 快速生成" Foreground="{StaticResource TextTertiary}" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,0"/>
        </StackPanel></ScrollViewer></Border>

        <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="预览" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="AI 生成内容" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="{StaticResource SurfaceRaised}" CornerRadius="14" Padding="10,5" VerticalAlignment="Center"><TextBlock x:Name="PreviewResolutionText" Text="720p · 9:16 · 5s" Foreground="{StaticResource TextSecondary}" FontSize="10"/></Border></DockPanel><Border Grid.Row="1" Background="#080A0F" CornerRadius="12" Margin="0,16"><Grid><MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"/><StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center"><Path Data="M 21 15 L 39 32 L 21 49 Z" Fill="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="准备生成你的画面" FontSize="15" HorizontalAlignment="Center" Margin="0,18,0,0"/><TextBlock Text="配置提示词后开始生成" Foreground="{StaticResource TextTertiary}" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Grid></Border><DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False"><TextBlock x:Name="StatusText" Text="准备就绪" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/><Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="打开文件夹" Click="OpenFolder_Click" IsEnabled="False" Width="108" Height="36"/></DockPanel></Grid></Border>

        <Border Grid.Column="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><StackPanel DockPanel.Dock="Left"><TextBlock Text="任务" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="最近的生成记录" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="13" Padding="9,5" VerticalAlignment="Center"><TextBlock x:Name="TaskCountText" Text="0" Foreground="{StaticResource Accent}" FontSize="10"/></Border></DockPanel><Grid Grid.Row="1"><ListBox x:Name="TaskList" Margin="0,18,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10"><StackPanel><DockPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11"/><TextBlock DockPanel.Dock="Right" Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}" Foreground="{StaticResource TextTertiary}" FontSize="10"/></DockPanel><TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}" FontSize="11" MaxHeight="42" Margin="0,8,0,0"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Danger}" FontSize="10" MaxHeight="30" Margin="0,6,0,0" ToolTip="{Binding ErrorMessage}"/><Grid Margin="0,10,0,0"><Border Background="{StaticResource Line}" Height="4" CornerRadius="2"/><Border Background="{StaticResource Cyan}" Height="4" Width="{Binding ProgressWidth}" HorizontalAlignment="Left" CornerRadius="2"/></Grid><DockPanel Margin="0,8,0,0"><TextBlock Text="图生视频" Foreground="{StaticResource TextTertiary}" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Foreground="{StaticResource TextTertiary}" FontSize="10"/></DockPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="EmptyTaskHint" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="暂无生成任务" HorizontalAlignment="Center" FontSize="13"/><TextBlock Text="生成视频后，任务会显示在这里" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center" FontSize="10" Margin="0,7,0,0"/></StackPanel></Grid></Grid></Border>
      </Grid>
      <DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="NavigationHintText" Text="提示：生成文件会保存到“视频\\土生视频”" Foreground="{StaticResource TextTertiary}" FontSize="10"/><TextBlock DockPanel.Dock="Right" Text="TuSheng Video Studio  ·  AI 创作工作台" Foreground="{StaticResource TextTertiary}" FontSize="10"/></DockPanel>
    </Grid>

    <Grid x:Name="SettingsRoot" Grid.Column="1" Margin="24,0,24,18" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><StackPanel VerticalAlignment="Center"><TextBlock Text="接口设置" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="连接视频模型，管理真实生成服务" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,5,0,0"/></StackPanel><Button Content="返回创作" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SettingsCancel_Click"/></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel Width="820" HorizontalAlignment="Center"><TextBlock Text="连接配置" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="2,0,0,10"/><TextBlock Text="服务商" FontSize="15" FontWeight="SemiBold" Margin="2,24,0,10"/><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel><UniformGrid Columns="4" Rows="2"><RadioButton x:Name="VolcProviderButton" GroupName="Provider" Content="火山方舟 · Seedance" Height="38" Margin="4" HorizontalContentAlignment="Center" Checked="Provider_Changed"/><RadioButton x:Name="XaiProviderButton" GroupName="Provider" Content="xAI · Grok Imagine" Height="38" Margin="4" HorizontalContentAlignment="Center" Checked="Provider_Changed"/><RadioButton x:Name="KlingProviderButton" GroupName="Provider" Content="Kling AI" Height="38" Margin="4" HorizontalContentAlignment="Center" Checked="Provider_Changed"/><RadioButton x:Name="RunwayProviderButton" GroupName="Provider" Content="Runway" Height="38" Margin="4" HorizontalContentAlignment="Center" Checked="Provider_Changed"/><RadioButton x:Name="LumaProviderButton" GroupName="Provider" Content="Luma Dream Machine" Height="38" Margin="4" HorizontalContentAlignment="Center" Checked="Provider_Changed"/><RadioButton x:Name="GoogleVeoProviderButton" GroupName="Provider" Content="Google Veo" Height="38" Margin="4" HorizontalContentAlignment="Center" Checked="Provider_Changed"/><RadioButton x:Name="WanProviderButton" GroupName="Provider" Content="阿里云 Wan" Height="38" Margin="4" HorizontalContentAlignment="Center" Checked="Provider_Changed"/><RadioButton x:Name="MinimaxProviderButton" GroupName="Provider" Content="MiniMax · Hailuo" Height="38" Margin="4" HorizontalContentAlignment="Center" Checked="Provider_Changed"/></UniformGrid><TextBlock Text="选择服务商后会自动填充接口地址和默认模型。接口字段由适配器统一处理。" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border><TextBlock Text="模型连接" FontSize="15" FontWeight="SemiBold" Margin="2,24,0,10"/><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel><Label Content="API Key"/><PasswordBox x:Name="SettingsApiKeyBox" Margin="0,0,0,14"/><Label Content="生成接口地址（自动配置）"/><TextBox x:Name="SettingsEndpointBox" IsReadOnly="True" Margin="0,0,0,14"/><Label Content="模型 / 接入点 ID（可修改）"/><ComboBox x:Name="SettingsModelBox" IsEditable="True" IsTextSearchEnabled="False" Margin="0"/><TextBlock Text="API Key 直接填写即可。模型默认值可替换；图生视频需要公网可访问的参考图 URL。" TextWrapping="Wrap" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer><Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="设置会保存在本机" Foreground="{StaticResource TextTertiary}" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Width="72" Click="SettingsCancel_Click"/><Button Content="保存设置" Width="100" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="#17111F" Margin="8,0,0,0" Click="SettingsSave_Click"/></StackPanel></Grid></Grid>
  </Grid>
</Window>










