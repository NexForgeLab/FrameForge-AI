<Window x:Class="VideoStudioMvp.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="接口设置" Width="620" Height="600" MinWidth="620" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{StaticResource AppBg}" ResizeMode="NoResize">
  <Grid Margin="30,26,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="接口设置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="连接视频模型，开始真实生成" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,6,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource GhostButton}" Click="Cancel_Click"/></DockPanel>
    <StackPanel Grid.Row="1" Margin="0,24,0,20">
      <TextBlock Text="模型连接" FontSize="14" FontWeight="SemiBold" Margin="2,22,0,12"/><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><Label Content="API Key"/><PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,14"/><Label Content="生成接口地址"/><TextBox x:Name="EndpointBox" Margin="0,0,0,14"/><Label Content="模型 / 接入点 ID"/><TextBox x:Name="ModelBox"/><TextBlock Text="接口地址、查询路径和模型 ID 请以火山引擎控制台当前文档为准。" TextWrapping="Wrap" Foreground="{StaticResource TextTertiary}" FontSize="11" Margin="0,14,0,0"/></StackPanel></Border></StackPanel>
    <DockPanel Grid.Row="2"><TextBlock Text="设置会保存在本机" Foreground="{StaticResource TextTertiary}" FontSize="11" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" Click="Cancel_Click"/><Button Content="保存设置" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Click="Save_Click"/></StackPanel></DockPanel>
  </Grid>
</Window>


